        <mxCell id="_x1P33FGWcMbOGOmZJNg-10" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;fontSize=18;" value="&lt;li&gt;Member memilih metode pembayaran.  &lt;/li&gt;&lt;li&gt;Sistem menampilkan informasi pembayaran.  &lt;/li&gt;&lt;li&gt;Member melakukan pembayaran.  &lt;/li&gt;&lt;li&gt;Sistem menyimpan data pembayaran.  &lt;/li&gt;&lt;li&gt;Sistem melakukan verifikasi pembayaran.  &lt;/li&gt;&lt;li&gt;Jika pembayaran gagal, sistem menampilkan pesan gagal.  &lt;/li&gt;&lt;li&gt;Jika pembayaran berhasil, sistem menampilkan struk pembayaran.  &lt;/li&gt;&lt;li&gt;Selesai.&lt;/li&gt;" vertex="1">
