        <mxCell id="_x1P33FGWcMbOGOmZJNg-6" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;fontSize=18;" value="&lt;li&gt;&lt;font style=&quot;font-size: 23px;&quot;&gt;Pengguna membuka aplikasi sistem gym.  &lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font style=&quot;font-size: 23px;&quot;&gt;Pengguna memasukkan email dan password.  &lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font style=&quot;font-size: 23px;&quot;&gt;Pengguna klik tombol login.&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font style=&quot;font-size: 23px;&quot;&gt;Sistem melakukan validasi data login.  &lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font style=&quot;font-size: 23px;&quot;&gt;Jika login gagal, sistem menampilkan pesan error.  &lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font style=&quot;font-size: 23px;&quot;&gt;Jika login berhasil, sistem menampilkan menu sesuai role (Member atau Admin).  &lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font style=&quot;font-size: 23px;&quot;&gt;Selesai.&lt;/font&gt;&lt;/li&gt;" vertex="1">
          <mxGeometry height="245" width="307.5" x="516" y="286.25" as="geometry" />
        </mxCell>
        <mxCell id="_x1P33FGWcMbOGOmZJNg-7" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;strokeWidth=6;" value="&lt;font style=&quot;font-size: 25px;&quot;&gt;Activity Diagram Melihat Paket/ Membeli Memership&lt;/font&gt;" vertex="1">
          <mxGeometry height="30" width="360" x="1330" y="205" as="geometry" />
        </mxCell>
        <mxCell id="_x1P33FGWcMbOGOmZJNg-8" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;fontSize=18;" value="&lt;li&gt;Member membuka aplikasi sistem gym.  &lt;/li&gt;&lt;li&gt;Member melakukan login ke dalam sistem.  &lt;/li&gt;&lt;li&gt;Sistem menampilkan menu member.  &lt;/li&gt;&lt;li&gt;Member memilih menu paket membership.  &lt;/li&gt;&lt;li&gt;Sistem menampilkan daftar paket membership.  &lt;/li&gt;&lt;li&gt;Member memilih salah satu paket membership.  &lt;/li&gt;&lt;li&gt;Sistem menampilkan detail paket yang dipilih.  &lt;/li&gt;&lt;li&gt;Member memilih beli atau perpanjang paket.  &lt;/li&gt;&lt;li&gt;Sistem menampilkan informasi pembayaran.  &lt;/li&gt;&lt;li&gt;Member melanjutkan ke proses pembayaran.  &lt;/li&gt;&lt;li&gt;Selesai.&lt;/li&gt;" vertex="1">
